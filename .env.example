# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# ─── GitHub App Configuration ───────────────────────────────────────────
# Create your GitHub App at: https://github.com/settings/apps/new
# Webhook URL: https://<YOUR_DEPLOYED_DOMAIN>/api/webhooks/github

# The App ID shown on your GitHub App settings page
GITHUB_APP_ID="5268255"

# A secret string you set when creating the GitHub App (used to verify webhook payloads)
GITHUB_WEBHOOK_SECRET="e3abebe22647fe09b0cb33f9d3a84398b1f49a12d0c0135b99430080167c3935"

# The Client ID from your GitHub App (for OAuth login flows)
GITHUB_CLIENT_ID="Ov23liTtMmMENDKdgxsw"

# The Client Secret from your GitHub App
GITHUB_CLIENT_SECRET="5fc28342d592e518def90b8c2acfa3db55dcaac9"

# Path to the .pem private key file downloaded when you created the App
GITHUB_PRIVATE_KEY_PATH="./ghostrunner-app.pem"

# ─── Webhook Server ─────────────────────────────────────────────────────
# Port the webhook Express server listens on (default: 4000)
WEBHOOK_PORT=4000

# ─── Local Development (smee.io proxy) ──────────────────────────────────
# 1. Go to https://smee.io and click "Start a new channel"
# 2. Copy the URL and paste it below
# 3. Use this SAME URL as the "Webhook URL" when creating your GitHub App
SMEE_URL="https://smee.io/3T9zULROnsIn6Cr7"
